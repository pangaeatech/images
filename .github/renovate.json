{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>pangaeatech/.github"],
  "baseBranchPatterns": ["main"],
  "branchPrefix": "renovate/",
  "enabledManagers": ["custom.regex", "dockerfile"],
  "dockerfile": {
    "managerFilePatterns": ["/(^|/).*\\.dockerfile$/"]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "registryUrls": ["https://dhi.io"]
    },
    {
      "description": "dhi.io floating tags (e.g. trixie-debian13-dev) are not versioned; track them by digest",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dhi.io/**"],
      "pinDigests": true
    },
    {
      "matchDatasources": ["apk"],
      "registryUrls": [
        "https://dhi.io/apk/alpine/v3.24/main?arch=x86_64",
        "https://dl-cdn.alpinelinux.org/alpine/v3.24/community?arch=x86_64"
      ]
    },
    {
      "description": "Default: Debian trixie for every apt pin in a Dockerfile",
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://deb.debian.org/debian/?suite=trixie&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian-security/?suite=trixie-security&components=main&binaryArch=amd64",
        "https://dhi.io/deb/debian/main/?suite=trixie&components=main&binaryArch=amd64",
        "https://packages.microsoft.com/debian/13/prod?suite=trixie&components=main&binaryArch=amd64"
      ]
    }
  ]
}
