{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>pangaeatech/.github"],
  "baseBranchPatterns": ["main"],
  "branchPrefix": "renovate/",
  "enabledManagers": ["custom.regex", "dockerfile"],
  "dockerfile": {
    "managerFilePatterns": ["/(^|/).*\\.dockerfile$/"]
  },
  "packageRules": [
    {
      "description": "Default: Debian trixie for every apt pin in a Dockerfile",
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=trixie&components=main,contrib&binaryArch=amd64",
        "https://deb.debian.org/debian?suite=trixie-updates&components=main,contrib&binaryArch=amd64",
        "https://deb.debian.org/debian-security?suite=trixie-security&components=main,contrib&binaryArch=amd64"
      ]
    },
    {
      "description": "Override: Microsoft packages come from packages.microsoft.com",
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["deb"],
      "matchPackageNames": [
        "/^dotnet-/",
        "/^aspnetcore-/",
        "powershell",
        "/^msodbcsql/",
        "/^mssql-tools/"
      ],
      "registryUrls": [
        "https://packages.microsoft.com/debian/13/prod?suite=trixie&components=main&binaryArch=amd64"
      ]
    }
  ]
}
